# Dummy EmailJS credentials for test builds only.
#
# The contact form's submit handler returns early - without calling fetch at
# all - when these are unset, which is correct behaviour and is what a visitor
# would see if the site were misconfigured. It also meant the test asserting
# that a real message reaches the endpoint only passed on a machine that had a
# real .env, and failed in CI for a reason that had nothing to do with the
# code. Mode-specific values take precedence over .env, so the test build is
# configured identically everywhere and never reads real credentials.
VITE_EMAILJS_SERVICE_ID=test_service
VITE_EMAILJS_TEMPLATE_ID=test_template
VITE_EMAILJS_PUBLIC_KEY=test_public_key
